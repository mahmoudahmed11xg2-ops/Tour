rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin access is controlled strictly via /admins/{uid} (or Firebase Custom Claim),
    // never via client-writable /users/{uid}.role
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isBookingParticipant(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId)) && (
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.touristId == request.auth.uid ||
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.guideId == request.auth.uid
      );
    }

    function isApprovedGuide(guideId) {
      return exists(/databases/$(database)/documents/guides/$(guideId)) &&
        get(/databases/$(database)/documents/guides/$(guideId)).data.verificationStatus == "approved" &&
        get(/databases/$(database)/documents/guides/$(guideId)).data.verified == true;
    }

    function isValidBookingStatus(status) {
      return status in [
        "pending",
        "accepted",
        "confirmed",
        "guide_arriving",
        "meeting_started",
        "in_progress",
        "completed",
        "cancelled",
        "rejected",
        "expired",
        "refunded",
        "disputed"
      ];
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
        "id", "touristId", "guideId", "bookingType", "status",
        "location", "date", "startTime", "endTime", "duration", "total"
      ]) &&
      data.id is string && data.id.size() <= 64 &&
      data.touristId is string && data.touristId.size() <= 128 &&
      data.guideId is string && data.guideId.size() <= 128 &&
      data.bookingType in ["instant", "scheduled"] &&
      isValidBookingStatus(data.status) &&
      data.location is string && data.location.size() <= 200 &&
      data.date is string && data.date.size() <= 20 &&
      data.startTime is string && data.startTime.size() <= 10 &&
      data.endTime is string && data.endTime.size() <= 10 &&
      data.duration is number && data.duration >= 1 && data.duration <= 24 &&
      data.total is number && data.total >= 0 &&
      (!("candidateGuideIds" in data) || (data.candidateGuideIds is list && data.candidateGuideIds.size() <= 50)) &&
      (!("declinedGuideIds" in data) || (data.declinedGuideIds is list && data.declinedGuideIds.size() <= 50));
    }

    function isValidBusySlot(data, slotId) {
      return data.keys().hasAll([
        "bookingId", "guideId", "createdByUid", "date",
        "startTime", "endTime", "startMs", "endMs", "status"
      ]) &&
      data.keys().hasOnly([
        "bookingId", "guideId", "createdByUid", "date",
        "startTime", "endTime", "startMs", "endMs", "duration", "status", "updatedAt"
      ]) &&
      data.bookingId == slotId &&
      data.guideId is string && data.guideId.size() <= 128 &&
      data.createdByUid is string && data.createdByUid.size() <= 128 &&
      data.date is string && data.date.size() <= 20 &&
      data.startTime is string && data.startTime.size() <= 10 &&
      data.endTime is string && data.endTime.size() <= 10 &&
      data.startMs is number &&
      data.endMs is number && data.endMs > data.startMs &&
      data.status is string && data.status.size() <= 30;
    }

    function isValidMessage(data, messageId) {
      return data.keys().hasAll([
        "id", "bookingId", "touristId", "guideId", "senderId", "text", "createdAt"
      ]) &&
      data.keys().hasOnly([
        "id", "bookingId", "touristId", "guideId", "senderId", "senderRole", "senderName", "text", "createdAt"
      ]) &&
      data.id == messageId &&
      data.bookingId is string && data.bookingId.size() <= 64 &&
      data.touristId is string && data.touristId.size() <= 128 &&
      data.guideId is string && data.guideId.size() <= 128 &&
      data.senderId is string && data.senderId.size() <= 128 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
      data.createdAt is string && data.createdAt.size() <= 64;
    }

    // 1. Admins Collection (Console / Admin-SDK managed ONLY)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 2. Users Collection (Strict RBAC: self cannot promote role or activate/unblock status)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                    isValidId(userId) &&
                    request.auth.uid == userId &&
                    incoming().uid == userId && (
                      isAdmin() ||
                      (incoming().role in ["tourist", "guide"] &&
                       incoming().status == (incoming().role == "guide" ? "pending" : "active"))
                    );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         incoming().uid == existing().uid &&
         incoming().role == existing().role && (
           // Standard profile fields update
           (incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              "firstName", "lastName", "phone", "country", "preferredLanguage", "photoURL", "updatedAt"
            ])) ||
           // Request-based account deletion
           (existing().status != "deletion_requested" &&
            incoming().status == "deletion_requested" &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              "status", "deletionRequestedAt", "updatedAt"
            ]))
         ))
      );

      allow delete: if isAdmin();
    }

    // 3. Tourists Profiles Collection
    match /tourists/{touristId} {
      allow get: if isSignedIn() && (request.auth.uid == touristId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                    isValidId(touristId) && (
                      isAdmin() ||
                      (request.auth.uid == touristId &&
                       incoming().uid == touristId &&
                       incoming().userId == touristId)
                    );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == touristId &&
         incoming().uid == existing().uid &&
         incoming().userId == existing().userId &&
         incoming().createdAt == existing().createdAt)
      );

      allow delete: if isAdmin();
    }

    // 4. Guides Marketplace Collection
    match /guides/{guideId} {
      allow get, list: if isSignedIn() && (
        existing().verificationStatus == "approved" ||
        request.auth.uid == guideId ||
        isAdmin()
      );

      allow create: if isSignedIn() && isValidId(guideId) && (
        isAdmin() ||
        (request.auth.uid == guideId &&
         incoming().id == guideId &&
         incoming().verificationStatus == "pending" &&
         incoming().verified == false &&
         (!("isApproved" in incoming()) || incoming().isApproved == false) &&
         incoming().isOnline == false)
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == guideId &&
         incoming().id == existing().id &&
         incoming().verificationStatus == existing().verificationStatus &&
         incoming().verified == existing().verified &&
         incoming().get("isApproved", false) == existing().get("isApproved", false) &&
         incoming().get("rating", 0) == existing().get("rating", 0) &&
         incoming().get("reviewCount", 0) == existing().get("reviewCount", 0) &&
         incoming().get("reviewsCount", 0) == existing().get("reviewsCount", 0) &&
         incoming().get("createdAt", "") == existing().get("createdAt", "") &&
         (incoming().isOnline == false || (
           existing().verificationStatus == "approved" && existing().verified == true
         )))
      );

      allow delete: if isAdmin();
    }

    // 5. Bookings Collection (Participant-Scoped & Strict State Machine)
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidId(bookingId) &&
                    isValidBooking(incoming()) &&
                    incoming().id == bookingId &&
                    (isAdmin() || (
                      incoming().touristId == request.auth.uid &&
                      incoming().status == "pending" &&
                      isApprovedGuide(incoming().guideId)
                    ));

      allow update: if isSignedIn() &&
                    isValidBooking(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().touristId == existing().touristId &&
                    incoming().bookingType == existing().bookingType &&
                    incoming().createdAt == existing().createdAt && (
        isAdmin() ||

        // Guide Accept: pending -> confirmed (Requires admin-approved guide)
        (existing().guideId == request.auth.uid &&
         isApprovedGuide(request.auth.uid) &&
         existing().status == "pending" &&
         incoming().status == "confirmed" &&
         incoming().guideId == existing().guideId &&
         incoming().diff(existing()).affectedKeys().hasOnly(["status", "acceptedAt", "confirmedAt", "updatedAt"])) ||

        // Guide Decline on Instant -> Automatic Fallback Dispatch to Next Approved Candidate
        (existing().guideId == request.auth.uid &&
         existing().status == "pending" &&
         existing().bookingType == "instant" &&
         incoming().status == "pending" &&
         incoming().guideId != existing().guideId &&
         isApprovedGuide(incoming().guideId) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           "guideId", "guideName", "hourlyRate", "price", "platformFee", "total",
           "declinedGuideIds", "candidateGuideIds", "reassignedAt", "updatedAt"
         ])) ||

        // Guide Decline -> Rejected
        (existing().guideId == request.auth.uid &&
         existing().status == "pending" &&
         incoming().status == "rejected" &&
         incoming().diff(existing()).affectedKeys().hasOnly(["status", "declinedGuideIds", "rejectionReason", "updatedAt"])) ||

        // Guide Sequential Operational Transitions (no skipping)
        (existing().guideId == request.auth.uid &&
         isApprovedGuide(request.auth.uid) &&
         incoming().guideId == existing().guideId &&
         incoming().diff(existing()).affectedKeys().hasOnly(["status", "startedAt", "completedAt", "updatedAt"]) && (
           (existing().status == "accepted" && incoming().status == "confirmed") ||
           (existing().status == "confirmed" && incoming().status == "guide_arriving") ||
           (existing().status == "guide_arriving" && incoming().status == "meeting_started") ||
           (existing().status == "meeting_started" && incoming().status == "in_progress") ||
           (existing().status == "in_progress" && incoming().status == "completed")
         )) ||

        // Tourist Retry Instant Booking from rejected/expired -> pending
        (existing().touristId == request.auth.uid &&
         existing().bookingType == "instant" &&
         existing().status in ["rejected", "expired"] &&
         incoming().status == "pending" &&
         isApprovedGuide(incoming().guideId) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           "guideId", "guideName", "date", "startTime", "endTime", "startMs", "endMs",
           "hourlyRate", "price", "platformFee", "total", "status",
           "declinedGuideIds", "candidateGuideIds", "rejectionReason", "updatedAt"
         ])) ||

        // Tourist or Guide Cancel before tour starts
        ((existing().touristId == request.auth.uid || existing().guideId == request.auth.uid) &&
         existing().status in ["pending", "accepted", "confirmed", "guide_arriving"] &&
         incoming().status == "cancelled" &&
         incoming().diff(existing()).affectedKeys().hasOnly(["status", "cancelReason", "cancelledBy", "updatedAt"])) ||

        // Tourist or Guide Open Dispute
        ((existing().touristId == request.auth.uid || existing().guideId == request.auth.uid) &&
         !(existing().status in ["cancelled", "rejected", "expired", "refunded"]) &&
         incoming().status == "disputed" &&
         incoming().diff(existing()).affectedKeys().hasOnly(["status", "disputeReason", "disputedBy", "updatedAt"])) ||

        // Tourist Review Flag on Completed Booking
        (existing().touristId == request.auth.uid &&
         existing().status == "completed" &&
         incoming().status == "completed" &&
         incoming().diff(existing()).affectedKeys().hasOnly(["reviewed", "reviewRating", "updatedAt"]))
      );

      allow delete: if isAdmin();
    }

    // 6. Non-PII Guide Busy Slots Collection (Double-Booking Conflict Checks)
    match /guideBusySlots/{slotId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                    isValidId(slotId) &&
                    isValidBusySlot(incoming(), slotId) &&
                    (isAdmin() || incoming().createdByUid == request.auth.uid);

      allow update: if isSignedIn() &&
                    isValidBusySlot(incoming(), slotId) &&
                    incoming().createdByUid == existing().createdByUid &&
                    (isAdmin() || existing().createdByUid == request.auth.uid || existing().guideId == request.auth.uid);

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.createdByUid == request.auth.uid ||
        resource.data.guideId == request.auth.uid
      );
    }

    // 7. Payments & Escrow Collection
    match /payments/{paymentId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidId(paymentId) && (
                      isAdmin() ||
                      (paymentId == "PAY-" + incoming().bookingId &&
                       incoming().paymentId == paymentId &&
                       incoming().status == "held_in_escrow" &&
                       incoming().amount is number && incoming().amount >= 0 &&
                       exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.touristId == incoming().touristId &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.guideId == incoming().guideId &&
                       (request.auth.uid == incoming().guideId || request.auth.uid == incoming().touristId))
                    );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(["status", "updatedAt"]) &&
         exists(/databases/$(database)/documents/bookings/$(existing().bookingId)) && (
           (incoming().status == "released_to_guide" &&
            existing().guideId == request.auth.uid &&
            get(/databases/$(database)/documents/bookings/$(existing().bookingId)).data.status == "completed") ||
           (incoming().status == "refunded" &&
            (existing().touristId == request.auth.uid || existing().guideId == request.auth.uid) &&
            get(/databases/$(database)/documents/bookings/$(existing().bookingId)).data.status in ["cancelled", "refunded"])
         ))
      );

      allow delete: if isAdmin();
    }

    // 8. Guide Payouts Collection
    match /payouts/{payoutId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.guideId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidId(payoutId) && (
                      isAdmin() ||
                      (incoming().id == payoutId &&
                       incoming().payoutId == payoutId &&
                       incoming().guideId == request.auth.uid &&
                       incoming().status == "pending" &&
                       incoming().amount is number && incoming().amount > 0 &&
                       isApprovedGuide(request.auth.uid))
                    );

      allow update, delete: if isAdmin();
    }

    // 9. Reviews Collection (1 review per completed booking enforced)
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                    isValidId(reviewId) && (
                      isAdmin() ||
                      (reviewId == "REV-" + incoming().bookingId &&
                       !exists(/databases/$(database)/documents/reviews/$(reviewId)) &&
                       incoming().id == reviewId &&
                       incoming().touristId == request.auth.uid &&
                       incoming().rating is number &&
                       incoming().rating >= 1 && incoming().rating <= 5 &&
                       (!("comment" in incoming()) || (incoming().comment is string && incoming().comment.size() <= 1000)) &&
                       exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.touristId == request.auth.uid &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.guideId == incoming().guideId &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == "completed")
                    );

      allow update, delete: if isAdmin();
    }

    // 10. Booking-Scoped Messages Collection
    match /messages/{messageId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidId(messageId) &&
                    isValidMessage(incoming(), messageId) &&
                    incoming().senderId == request.auth.uid &&
                    (isAdmin() || (
                      (incoming().touristId == request.auth.uid || incoming().guideId == request.auth.uid) &&
                      exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                      get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.touristId == incoming().touristId &&
                      get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.guideId == incoming().guideId
                    ));

      allow update, delete: if isAdmin();
    }

    // 11. Notifications Collection (Scoped to recipientId/userId)
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidId(notificationId) && (
                      isAdmin() ||
                      (incoming().senderId == request.auth.uid &&
                       incoming().read == false &&
                       incoming().recipientId is string &&
                       incoming().title is string &&
                       incoming().body is string)
                    );

      allow update: if isSignedIn() && (
        isAdmin() ||
        ((resource.data.recipientId == request.auth.uid || resource.data.userId == request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(["read", "readAt"]))
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // 12. Disputes Collection
    match /disputes/{disputeId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidId(disputeId) && (
                      isAdmin() ||
                      (incoming().id == disputeId &&
                       incoming().disputeId == disputeId &&
                       incoming().openedBy == request.auth.uid &&
                       incoming().status == "open" &&
                       isBookingParticipant(incoming().bookingId) &&
                       incoming().touristId == get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.touristId &&
                       incoming().guideId == get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.guideId)
                    );

      allow update, delete: if isAdmin();
    }

    // 13. Audit Logs Collection (Append-Only for signed-in actors, Admin read-only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
                    isValidId(logId) &&
                    (isAdmin() || incoming().actorId == request.auth.uid);
      allow update, delete: if false;
    }

    // 14. Platform Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
